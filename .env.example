APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
COOKIE_SECURE=false
DATABASE_URL=sqlite:///backend/data/app.db
EA_API_KEY=replace-with-a-random-key-at-least-24-characters

# Optional signal-processing services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_REGEX_FALLBACK=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Required to enable client registration and email verification.
# For Gmail, use a dedicated sender account with 2-Step Verification enabled
# and an App Password (not the normal Google password).
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=algentra.sender@gmail.com
# EMAIL_SMTP_PASSWORD=your-16-character-app-password
# EMAIL_FROM="Algentra Capital <algentra.sender@gmail.com>"
# EMAIL_SMTP_STARTTLS=true

# Public contact details displayed on the website. Use a WhatsApp number with country code.
CONTACT_PERSON_NAME=
CONTACT_WHATSAPP=
CONTACT_EMAIL=
CONTACT_INSTAGRAM=
CONTACT_TELEGRAM=
CONTACT_FACEBOOK=
CONTACT_LINKEDIN=
CONTACT_X=
CONTACT_YOUTUBE=
CONTACT_TIKTOK=
