# Copy this file to .env, then change both credentials before starting the app.
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword-BeforeRunning
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./backend/data/app.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RETRY_ATTEMPTS=3
ENABLE_REGEX_FALLBACK=false
