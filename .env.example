APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
COOKIE_SECURE=false
# Development uses a path relative to the project root. Production must use an absolute path outside the code folder.
DATABASE_URL=sqlite:///backend/data/app.db
EA_API_KEY=replace-with-a-random-key-at-least-24-characters

# Optional signal-processing services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Separate credential and optional model for the ALGENTRA customer-service chat.
GEMINI_CS_API_KEY=
GEMINI_CS_MODEL=gemini-3.8-flash
GEMINI_CS_TIMEOUT_SECONDS=60
ENABLE_REGEX_FALLBACK=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Required to enable client registration, email verification, and password resets.
# For Gmail, use a dedicated sender account with 2-Step Verification enabled
# and an App Password (not the normal Google password).
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=algentra.sender@gmail.com
# EMAIL_SMTP_PASSWORD=your-16-character-app-password
# EMAIL_FROM="Algentra Capital <algentra.sender@gmail.com>"
# EMAIL_SMTP_STARTTLS=true

# Public contact details displayed on the website. Use full HTTPS URLs for social channels.
CONTACT_PERSON_NAME=Algentra Capital
CONTACT_WHATSAPP=
CONTACT_EMAIL=algentracapital@gmail.com
CONTACT_INSTAGRAM=https://www.instagram.com/algentracapital.id/
CONTACT_TELEGRAM=https://t.me/algentra_capital
CONTACT_TELEGRAM_ADMIN=https://t.me/algentracapital
CONTACT_WEBSITE=https://algentracapital.my.id
CONTACT_FACEBOOK=
CONTACT_LINKEDIN=
CONTACT_X=
CONTACT_YOUTUBE=
CONTACT_TIKTOK=https://www.tiktok.com/@algentracapital.id
